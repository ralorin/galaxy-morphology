__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# raw data is not redistributed here, see README
data/
*.h5
*.zip
*.csv.gz

# everything the pipeline writes to scratch
work/
*.npy
*.pt
*.pth

# results/ IS committed -- see results/README.md. It holds the aggregate tables,
# the per-run metrics and the figures, which are small and are the record behind
# the paper. The per-galaxy prediction files are not: they are hundreds of
# megabytes and regenerable from the checkpoints.
results/**/predictions_*.csv

# The manuscript is convenient to keep next to the code that generates its numbers,
# but it is not part of the code and does not belong in this repository. Its
# figures and tables are archived under results/ by `src/publish.py`, so the exact
# assets the paper uses are versioned even though the paper itself is not.
paper5/
paper*/
manuscript/

# slurm output
logs/*.out
logs/*.err
